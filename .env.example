# Shipwright — local dev environment (copy to .env). Ports match docs/VERSIONS.md.

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
WEB_PORT=3000

# ---- Orchestrator (FastAPI) ----
ORCHESTRATOR_PORT=8000
SHIPWRIGHT_ENV=local
LOG_LEVEL=info
# Persistence backend: 'memory' (default, in-process) or 'postgres' (survives restart).
SHIPWRIGHT_STORE=memory

# Real code sandbox (agent branches/edits/tests/commits + opens a PR). 1 to enable.
SHIPWRIGHT_SANDBOX=0
SHIPWRIGHT_SANDBOX_ROOT=
# GitHub PR: set both to open a REAL PR (else safe dry-run). Token is Vault-backed in prod.
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BASE=main

# ---- Ingester (Go) ----
INGESTER_PORT=8090

# ---- Postgres (+ pgvector) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shipwright
POSTGRES_USER=shipwright
POSTGRES_PASSWORD=shipwright_dev
# Use a NON-SUPERUSER role so Row-Level Security (tenant isolation) is enforced, not bypassed.
DATABASE_URL=postgresql+asyncpg://shipwright_app@127.0.0.1:5432/shipwright_dev

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Temporal ----
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# ---- ClickHouse ----
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=shipwright

# ---- Object store (MinIO / S3) ----
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=shipwright
S3_SECRET_KEY=shipwright_dev
S3_BUCKET=shipwright-artifacts

# ---- Vault ----
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=shipwright-dev-root

# ---- Providers (leave blank; set to enable real calls) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Notifications (optional; enable channels + recipients in Settings) ----
# Each channel is a no-op until its credentials are set here. Legacy FOUNDRY_* names also work.
# Email (SMTP):
SHIPWRIGHT_SMTP_HOST=
SHIPWRIGHT_SMTP_PORT=587
SHIPWRIGHT_SMTP_USER=
SHIPWRIGHT_SMTP_PASSWORD=
SHIPWRIGHT_SMTP_FROM=
SHIPWRIGHT_SMTP_TLS=1
# WhatsApp via Twilio:
SHIPWRIGHT_TWILIO_ACCOUNT_SID=
SHIPWRIGHT_TWILIO_AUTH_TOKEN=
SHIPWRIGHT_TWILIO_WHATSAPP_FROM=
# WhatsApp via Meta Cloud API:
SHIPWRIGHT_WHATSAPP_TOKEN=
SHIPWRIGHT_WHATSAPP_PHONE_ID=
# Slack / generic incoming webhook:
SHIPWRIGHT_SLACK_WEBHOOK=
