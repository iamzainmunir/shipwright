# syntax=docker/dockerfile:1

# ---- build stage -----------------------------------------------------------
FROM golang:1.24 AS build
WORKDIR /src

# Cache module downloads. go.sum is generated by `go mod tidy`; the glob keeps
# this COPY valid before it exists.
COPY go.mod go.sum* ./
RUN go mod download

COPY . .

# Static, stripped binary for a scratch/distroless runtime.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/ingester .

# ---- run stage -------------------------------------------------------------
# distroless "static" == scratch + CA certs + a nonroot user (no shell, no libc).
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /

COPY --from=build /out/ingester /ingester

# Canon/VERSIONS.md: ingester listens on 8090.
ENV INGESTER_PORT=8090
EXPOSE 8090

USER nonroot:nonroot
ENTRYPOINT ["/ingester"]
